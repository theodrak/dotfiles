# ---- LTS Discord bot (~/lts-bot, run as a launchd service) ----

# Watches a Discord channel for Richard's LTS recording post and runs the

# transcribe-video pipeline. Full docs: ~/lts-bot/README.md

#

# THE ONE RULE: only ever one copy running. The launchd copy and a manual

# `python lts_bot.py` copy will BOTH pick up the same message, so the pipeline

# fires twice, downloads the same video twice, and corrupts the file. `ltsstart`

# and `ltsstop` below are written to make that impossible — use them rather than

# calling launchctl/pkill by hand.

# Start the bot via launchd (backgrounded, and auto-starts again on login).

# Refuses if any copy is already running, so it can't create a second one.

alias ltsstart="pgrep -f 'lts-bot/lts_bot.py' >/dev/null && echo 'lts-bot is already running — ltsstatus' || launchctl load ~/Library/LaunchAgents/com.theo.lts-bot.plist"

# Stop the bot, whichever way it was started, then confirm it's actually dead.

# Unloads launchd FIRST: the agent has KeepAlive=true, so a bare pkill would just

# get the process respawned a second later.

alias ltsstop="launchctl unload ~/Library/LaunchAgents/com.theo.lts-bot.plist 2>/dev/null; pkill -f 'lts-bot/lts_bot.py' 2>/dev/null; sleep 1; pgrep -fl 'lts-bot/lts_bot.py' || echo 'lts-bot stopped'"

# Restart cleanly — use after editing .env or lts_bot.py, since the running

# process holds the old config until it's actually restarted.

alias ltsrestart="ltsstop; ltsstart"

# Is it up? Prints the PID if a process is running, plus whether launchd has the

# agent loaded. Two PIDs here = the double-instance bug; run ltsstop, then ltsstart.

alias ltsstatus="pgrep -fl 'lts-bot/lts_bot.py' || echo 'lts-bot not running'; launchctl list | grep lts-bot || echo 'launchd agent not loaded'"

# Follow the bot's own stdout/stderr (did it log in? did it see the message?).

# For a live pipeline run instead, tail the per-run log: tail -f ~/lts-bot/logs/run-\*.log

alias ltslogs="tail -f ~/lts-bot/logs/bot.out.log ~/lts-bot/logs/bot.err.log"

